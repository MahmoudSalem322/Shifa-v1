# Copy to .env.local for local development. On Vercel, add the same names under
# Project Settings -> Environment Variables. NEVER commit real values.

# ---------- Required on Vercel ----------
# Persistent database (Supabase). Run supabase/schema.sql once in the SQL editor.
# Use the service_role key (server only) - NOT the anon key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SHIFA_EVIDENCE_BUCKET=shifaa-evidence

# Session signing secret: any random string of 32+ characters (e.g. `openssl rand -hex 32`).
LOCAL_AUTH_SECRET=

# Admin account (the only account that can approve doctors/hospitals/pharmacies).
ADMIN_EMAIL=admin.shifaa@gmail.com
ADMIN_USERNAME=admin.shifaa@gmail.com
ADMIN_PASSWORD=
ADMIN_NAME=مدير منصة شفاء
# Another random string of 32+ characters.
ADMIN_TOKEN_SECRET=

# ---------- Optional ----------
# Smart prescription reader + health navigator. Without a key the prescription reader
# uses the free in-browser OCR and the navigator uses its keyword fallback.
# NOTE: with a key, prescription images are sent to the Anthropic API.
ANTHROPIC_API_KEY=
SHIFA_PRESCRIPTION_MODEL=claude-sonnet-5-5
SHIFA_NAVIGATOR_MODEL=claude-sonnet-5-5
# Set to "off" to disable the smart prescription reader even when a key exists.
# SHIFA_PRESCRIPTION_AI=off

# Demo doctors/facilities/pharmacies are seeded only in local dev. Force on/off here.
# SHIFA_SEED_DEMO_DATA=false

# Local development only (JSON files instead of Supabase): where data is kept.
# SHIFA_DATA_DIR=./data

# Legacy (leave empty).
NEXT_PUBLIC_API_BASE=
SHIFA_API_BASE=
LEGACY_API_BASE=
